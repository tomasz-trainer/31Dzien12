<Window x:Class="P01AplikacjaNBP_WPF.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:P01AplikacjaNBP_WPF.Client"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Button Content="Pobierz kursy walut" Command="{Binding LoadRatesCommand}"></Button>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rates}" 
                  >

            <DataGrid.Columns>
                <DataGridTextColumn Header="Waluta" Binding="{Binding Currency}"></DataGridTextColumn>
                <DataGridTextColumn Header="Kod" Binding="{Binding Code}"></DataGridTextColumn>
                <DataGridTextColumn Header="Mid" Binding="{Binding Mid}"></DataGridTextColumn>
            </DataGrid.Columns>
            
        </DataGrid>
        
    </Grid>
</Window>
